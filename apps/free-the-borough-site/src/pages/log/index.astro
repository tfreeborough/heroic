---
import Base from "../../layouts/Base.astro";
import { logPosts } from "../../lib/log";
import { Image } from "astro:assets";

const posts = await logPosts();
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base
  title="Dev log — Free the Borough"
  description="Notes from making Blood in the Sand and whatever comes after it: how things work, what went wrong, what changed."
  noindex={posts.length === 0}
>
  <main>
    <div class="wrap log-wrap">
      <h1>Dev log</h1>
      <p class="lede">Notes from making the games. Some are videos written down, some are
      just things worth putting on paper: how a system works, what broke, what I changed
      my mind about.</p>
      {posts.length === 0 ? (
        <p>Nothing here yet.</p>
      ) : (
        <div class="log-grid">
          {posts.map((p) => (
            <a class="log-card" href={`/log/${p.id}/`}>
              {p.data.cover ? (
                <Image src={p.data.cover} width={960} alt="" loading="lazy" />
              ) : (
                <div class="log-plate" aria-hidden="true"><span>{p.data.title}</span></div>
              )}
              <div class="log-card-body">
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
</Base>
