---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Free the Borough" description="That page isn't here." noindex>
  <main>
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lede">That page isn't here. It might have moved, or the link was wrong.</p>
      <p>Try the <a href="/">home page</a>, the <a href="/support/">support page</a>,
      or the <a href="/privacy/">privacy policy</a>.</p>
    </div>
  </main>
</Base>
