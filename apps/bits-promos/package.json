{
  "name": "bits-promos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-assets.ts",
    "footage:sync": "bun ../desk/cli.ts sync bits",
    "studio": "bun run sync && remotion studio",
    "render": "bun run sync && remotion render",
    "still": "bun run sync && remotion still",
    "render:roster": "bun run sync && bun scripts/render-roster.ts",
    "render:store": "bun run sync && bun scripts/render-store.ts",
    "capture": "bun run sync && bun scripts/capture.ts",
    "capture:roster": "bun run sync && bun scripts/capture.ts --all",
    "upload": "rclone copy out \"gdrive,root_folder_id=1BKUER-5XJJa2kRZZ1NwaTlPl080niB5Q:Promos\" --include \"*.mp4\" --progress",
    "publish": "bun run render:roster && bun run upload",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "^4.0.0",
    "@remotion/google-fonts": "4.0.518",
    "@remotion/media-utils": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@heroic/blood-in-the-sand-sim": "workspace:*",
    "@types/react": "^19.0.0"
  },
  "exports": {
    "./desk.config": "./desk.config.ts",
    "./desk.templates": "./desk.templates.ts"
  }
}
