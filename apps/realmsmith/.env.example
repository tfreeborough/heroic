# Asset Forge provider keys (docs/design/asset-forge.md).
# Copy this file to `.env.local` (gitignored) and fill in real keys, then restart
# the dev server. Names deliberately have no VITE_ prefix — Vite never exposes
# them to browser code; only the forge plugin (dev server) reads them.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Sound engine (docs/design/asset-forge.md § Stable Audio). Default = ElevenLabs.
# "both" runs the local model AND ElevenLabs on the same prompt (takes tagged).
# "stable-audio" runs Stable Audio 3 Small-SFX LOCALLY from a sibling checkout
# (../../../stable-audio-3, override with STABLE_AUDIO_DIR). Weights are gated:
# accept the licence on huggingface.co/stabilityai/stable-audio-3-small-sfx and
# set a read token here — the first generation downloads them.
FORGE_SFX_PROVIDER=elevenlabs
HF_TOKEN=
