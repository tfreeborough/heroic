{
  "name": "blood-in-the-sand",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@clerk/expo": "^4.5.2",
    "@heroic/blood-in-the-sand-sim": "workspace:*",
    "@heroic/core": "workspace:*",
    "@heroic/engine": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~56.0.19",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.22",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.26",
    "expo-clipboard": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-iap": "^5.3.1",
    "expo-keep-awake": "~56.0.3",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.24",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-audio-api": "^0.13.2",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:device": "APP_VARIANT=development expo run:ios --device",
    "android": "APP_VARIANT=development expo run:android",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:android:dev": "eas build --platform android --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:preview": "eas build --platform android --profile preview",
    "ship": "eas build --platform all --profile production --auto-submit",
    "ship:ios": "eas build --platform ios --profile production --auto-submit",
    "ship:android": "eas build --platform android --profile production --auto-submit",
    "update:ota": "if [ -f .env.local ]; then echo 'refusing to publish: .env.local overrides .env.production during export and would bake local-dev URLs into the OTA bundle — move it aside first (or just push to master; CI publishes)'; exit 1; fi; eas update --channel production",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
